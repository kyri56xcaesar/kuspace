# kuspace secrets template.
#
# Copy to configs/secrets.env (gitignored) and fill in fresh values, e.g.:
#   openssl rand -hex 64   (JWT keys)
#   openssl rand -hex 32   (service secret)
#   openssl rand -hex 16   (passwords)
#
# configs/secrets.env is the single source of secrets:
#   - docker-compose reads it through deployments/docker-compose/.env
#     (ln -s ../../configs/secrets.env deployments/docker-compose/.env)
#   - `kuspacectl` turns it into deployments/kubernetes/secrets/secrets.yaml
#     (also gitignored) and applies it to the cluster.
# The *.conf files hold only non-secret settings.

# HMAC key for access tokens; shared by minioth (signing) and all services (verification)
JWT_SECRET_KEY=
# minioth refresh-token signing key
JWT_REFRESH_SECRET_KEY=
# shared X-Service-Secret between uspace, frontapp and wss
SERVICE_SECRET_KEY=
# minioth's per-service view of the same secret: uspace:<S>,frontapp:<S>,wss:<S>
MINIOTH_SERVICE_SECRETS=
# minioth root (kuspaceadmin) password
MINIOTH_SECRET_KEY=
# MinIO root (minioadmin) password
MINIO_SECRET_KEY=
# fslite admin password (standalone fslite only)
FSL_SECRET_KEY=
