FROM golang:1.26-bookworm AS builder

WORKDIR /app
COPY go.mod go.sum ./
COPY ./internal/utils/ ./internal/utils/
COPY ./internal/authn/ ./internal/authn/
COPY ./internal/frontapp/ ./internal/frontapp/
COPY ./cmd/frontapp/ ./cmd/frontapp/ 
# the build the System page shows (make images / kuspacectl pass them)
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=
RUN GOOS=linux go build -ldflags "-X kyri56xcaesar/kuspace/internal/utils.buildCommit=${GIT_COMMIT} -X kyri56xcaesar/kuspace/internal/utils.buildTime=${BUILD_TIME}" \
    -o ./cmd/frontapp/frontapp ./cmd/frontapp/main.go

FROM debian:bookworm-slim
WORKDIR /root/
RUN apt-get update && apt-get install -y libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY ./web/ ./web/
COPY --from=builder /app/cmd/frontapp/frontapp .

RUN chmod +x /root/frontapp
CMD ["./frontapp"]

