# syntax=docker/dockerfile:1
# Built with BuildKit (docker compose build / make images). Two caches keep
# rebuilds short: the modules download in their own layer (redone only when
# go.mod/go.sum change), and the Go build cache persists across builds on
# this machine, so only changed packages are compiled again (sqlite's C code
# once, not every time).
FROM golang:1.26-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY ./internal/utils/ ./internal/utils/
COPY ./internal/config/ ./internal/config/
COPY ./internal/wss/ ./internal/wss/
COPY ./cmd/wss/ ./cmd/wss/
# the build the System page shows (make images / kuspacectl pass them)
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w -X kyri56xcaesar/kuspace/internal/utils.buildCommit=${GIT_COMMIT} -X kyri56xcaesar/kuspace/internal/utils.buildTime=${BUILD_TIME}" \
    -o /out/wss ./cmd/wss

# no C code (no SQLite here): a static binary on a minimal image, with CA
# certificates and time zones but no shell
FROM gcr.io/distroless/static-debian12
WORKDIR /root/
COPY --from=builder /out/wss .
CMD ["./wss"]
